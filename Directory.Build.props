<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Result, Error and Maybe live in BasicResults - https://github.com/nsmela/BasicResults - and
    come from a sibling checkout of this repository rather than from a package: the solution
    clears all NuGet sources, so a PackageReference would have nowhere to restore from. Override
    BasicResultsRoot to build against a checkout elsewhere.
  -->
  <PropertyGroup>
    <BasicResultsRoot Condition="'$(BasicResultsRoot)' == ''">$(MSBuildThisFileDirectory)..\BasicResults\</BasicResultsRoot>
    <BasicResultsProject>$(BasicResultsRoot)src\BasicResults\BasicResults.csproj</BasicResultsProject>
  </PropertyGroup>
</Project>
