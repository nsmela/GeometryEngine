<?xml version="1.0" encoding="utf-8"?>
<!--
  The repository root clears all package sources so the library builds with zero
  external dependencies. The benchmark project is the one exception: it uses
  BenchmarkDotNet, so this config (which applies only to projects under bench/)
  restores nuget.org. Nothing in src/ or tests/ sees this source.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
