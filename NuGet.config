<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org, and nothing else. The library has two package dependencies, both for planar polygon
  work - Clipper2 for offsetting and unioning outlines, NetTopologySuite for concave hulls - and
  every project that references the library restores them transitively, so the source has to be
  visible from the root rather than only beside src/. See THIRD-PARTY-NOTICES.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
