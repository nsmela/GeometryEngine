<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>engine-harness</AssemblyName>
    <RootNamespace>Fabolus.SmoothingCompare.Engine</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Measurement code, not shipped: the repo-wide warnings-as-errors would fight the harness. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/GeometryEngine/GeometryEngine.csproj" />
    <!--
      Referenced directly as well: GeometryEngine marks its reference to Core private, so the
      Vec3 and IMesh this harness speaks in do not flow through from there.
    -->
    <ProjectReference Include="../../../src/GeometryEngine.Core/GeometryEngine.Core.csproj" />
  </ItemGroup>
</Project>
