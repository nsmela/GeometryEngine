+  // Deterministic numbering (Fabolus/GeometryEngine patch): the parallel passes above hand out
+  // vertex numbers and append triangles in whatever order their threads run, and everything
+  // downstream - halfedges, topology cleanup, sorting - then depends on that order. Renumber by
+  // where each vertex was made and sort the triangles, so the input to it is the same every run.
+  {
+    const size_t numVert = vertPos.size();
+    std::vector<int> order(numVert);
+    for (size_t i = 0; i < numVert; ++i) order[i] = static_cast<int>(i);
+    std::sort(order.begin(), order.end(),
+              [&vertKey](int a, int b) { return vertKey[a] < vertKey[b]; });
+    std::vector<int> rank(numVert);
+    Vec<vec3> sortedPos(numVert);
+    for (size_t r = 0; r < numVert; ++r) {
+      rank[order[r]] = static_cast<int>(r);
+      sortedPos[r] = vertPos[order[r]];
+    }
+    vertPos = std::move(sortedPos);
+
+    for (size_t t = 0; t < triVerts.size(); ++t) {
+      ivec3 tri(rank[triVerts[t][0]], rank[triVerts[t][1]], rank[triVerts[t][2]]);
+      // Rotate so the smallest index leads; the winding is unchanged.
+      while (tri[0] > tri[1] || tri[0] > tri[2]) tri = ivec3(tri[1], tri[2], tri[0]);
+      triVerts[t] = tri;
+    }
+    std::sort(triVerts.begin(), triVerts.end(), [](const ivec3& a, const ivec3& b) {
+      if (a[0] != b[0]) return a[0] < b[0];
+      if (a[1] != b[1]) return a[1] < b[1];
+      return a[2] < b[2];
+    });
+  }
+
