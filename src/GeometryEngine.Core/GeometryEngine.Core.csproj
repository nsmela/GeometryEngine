<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GeometryEngine.Core</RootNamespace>
    <!--
      Core ships inside the GeometryEngine package rather than as one of its own - see
      GeometryEngine.csproj. Without this, `dotnet pack` over the solution would also emit a
      GeometryEngine.Core package that duplicates assemblies already in GeometryEngine and that nothing
      references.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Core's public API returns Result<T> and Maybe<T>, so this reference is deliberately not
    private: a consumer of Core cannot read what Core returns without it. The version is pinned
    in Directory.Build.props.
  -->
  <ItemGroup>
    <PackageReference Include="BasicResults" Version="$(BasicResultsVersion)" />
  </ItemGroup>

  <!--
    The engine fills each mesh's measurement cache (MeshMeasurements) as it measures. It ships in
    the same package as Core, so this is one library talking to itself rather than a seam a
    consumer could see.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="GeometryEngine" />
    <InternalsVisibleTo Include="GeometryEngine.Tests" />
  </ItemGroup>
</Project>
